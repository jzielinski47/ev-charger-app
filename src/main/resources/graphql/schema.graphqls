type Query {
    chargerPointById(id: ID!): ChargerPoint
    allChargerPointsInProximity(lat: Float!, lon: Float!, proximity: Float!, vehicleId: ID): [ChargerPoint!]!
}

type ChargerPoint {
    id: ID!
    addressInfo: AddressInfo!
    connections: [Connection!]!
    operator: Operator
    dataProvider: DataProvider
    isOperational: Boolean
    usageCost: String
    numberOfPoints: Int
    dateLastVerified: String
    dateLastConfirmed: String
}

type DataProvider {
    id: ID!
    license: String
}

type Operator {
    id: ID!
    name: String
    websiteUrl: String
    phone: String
    email: String
    faultReportEmail: String
}

type AddressInfo {
    id: ID!
    title: String
    addressLine1: String
    town: String
    latitude: Float
    longitude: Float
    accessComments: String
}

type Connection {
    id: ID!
    amps: Int
    voltage: Int
    powerKW: Float
    quantity: Int
    connectorType: String
    currentType: String
}
type Query {
    chargerPointById(id: ID!): ChargerPoint
    allChargerPointsInProximity(lat: Float!, lon: Float!, proximity: Float!, vehicleId: ID,
                                filter: ChargerFilter, sort: ChargerSort = DISTANCE,
                                limit: Int = 100, offset: Int = 0): [ChargerPoint!]!
    allChargerPointsInBounds(north: Float!, south: Float!, east: Float!, west: Float!, vehicleId: ID,
                             filter: ChargerFilter, sort: ChargerSort = DISTANCE,
                             limit: Int = 100, offset: Int = 0): [ChargerPoint!]!
}

enum ChargerSort {
    DISTANCE
    POWER
    POINTS
}

input ChargerFilter {
    currentType: CurrentKind
    operationalOnly: Boolean
}

enum CurrentKind {
    AC
    DC
}

type ChargerPoint {
    id: ID!
    addressInfo: AddressInfo!
    connections: [Connection!]!
    operator: Operator
    dataProvider: DataProvider
    isOperational: Boolean
    usageCost: String
    numberOfPoints: Int
    dateLastVerified: String
    dateLastConfirmed: String
    distanceKm: Float
}

type DataProvider {
    id: ID!
    license: String
}

type Operator {
    id: ID!
    name: String
    websiteUrl: String
    phone: String
    email: String
    faultReportEmail: String
}

type AddressInfo {
    id: ID!
    title: String
    addressLine1: String
    town: String
    latitude: Float
    longitude: Float
    accessComments: String
}

type Connection {
    id: ID!
    amps: Int
    voltage: Int
    powerKW: Float
    quantity: Int
    connectorType: String
    currentType: String
}